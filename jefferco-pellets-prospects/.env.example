# Mot de passe d'accès à l'application (obligatoire)
PELLETS_ADMIN_PASSWORD=change-moi

# Nécessaire uniquement en production pour que les modifications (ajout /
# édition de prospects) soient enregistrées via un commit GitHub.
# Jeton à portée fine, limité à ce dépôt, permission "Contents: Read and write".
GITHUB_TOKEN=

# Dépôt et branche où vit ce projet (par défaut : ce dépôt, branche main)
GITHUB_REPOSITORY=Druelle2U0I/Fjhj
GITHUB_BRANCH=main

# Chemin de ce projet DANS le dépôt ci-dessus (laisser vide si le dépôt est
# entièrement dédié à ce projet). Nécessaire ici car ce projet cohabite avec
# le site ENMA Formation dans le même dépôt.
GITHUB_BASE_PATH=jefferco-pellets-prospects
